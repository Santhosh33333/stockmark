{
  "name": "stock-mark-analysis",
  "version": "1.0.0",
  "description": "Live NSE/BSE stock scanner with SMC (wick rejection + order block + inducement) strategy, user accounts, paper trading and Dhan Algo live execution",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node scripts/selftest.js",
    "test:unit": "node scripts/unittest.js",
    "preset:india": "node -e \"require('./src/providers/symbols.js').buildUniverse().then(u=>console.log('NSE:',u.nse.length,'BSE:',u.bse.length,'F&O:',u.fno.length))\""
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "express": "^4.21.2",
    "nodemailer": "^6.9.16"
  }
}
