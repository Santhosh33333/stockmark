# Copy to `.env` before `docker compose up -d --build`.
# `.env` is gitignored — never commit real secrets.

# ── Owner account (seeded on first boot; you sign in with these) ─────────
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-something-strong

# ── Public sign-ups: on = anyone can register, off = owner only ──────────
ALLOW_SIGNUP=on

# ── Public address used for automatic HTTPS (Caddy) ──────────────────────
# Easiest: no domain needed — put your VM's PUBLIC IP in front of sslip.io.
#   e.g. for IP 203.0.113.10  →  SITE_ADDRESS=203.0.113.10.sslip.io
# With your own domain, use app.example.com and point an A record at the VM.
SITE_ADDRESS=203.0.113.10.sslip.io

# ── Optional tuning (defaults are fine) ──────────────────────────────────
# ALERT_POLL_MS=60000
# SCAN_CONCURRENCY=12
# DATA_DIR=/app/data        # already set by docker-compose.yml
