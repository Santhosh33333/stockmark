# ── Free runtime options (all optional — defaults work out of the box) ──
PORT=5124
HOST=0.0.0.0

# Owner account (ADMIN). Also kept in owner.json locally.
# ADMIN_EMAIL=santhoshkrishna958@gmail.com
# ADMIN_PASSWORD=change-this

# Scanner speed
SCAN_CONCURRENCY=12
SCAN_DAILY_RANGE=8mo
SCAN_HOURLY_RANGE=45d

# Email OTP — FREE senders (pick one, or leave unset for dev mode)
# 1) Brevo (free 300 emails/day): https://brevo.com → SMTP & API → API keys
# MAIL_PROVIDER=brevo
# BREVO_API_KEY=xkeysib-...
# 2) Gmail with an App Password (free): https://myaccount.google.com/apppasswords
# MAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM=no-reply@stockartha.app
MAIL_FROM_NAME=StockArtha

OTP_TTL_MINUTES=10

# Dhan live execution (optional) — keys belong to the account owner inside the app UI
# DHAN_BASE_URL=https://api.dhan.co
