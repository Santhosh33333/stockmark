# ── TradeMind — environment variables (copy to .env or set in your shell) ──
# Nothing here is required: the app runs fully on free Yahoo Finance data.
# Never commit real secrets. Owner credentials go in owner.json (gitignored).

# Server
PORT=5124
HOST=0.0.0.0

# Where app.db lives. Point this at a mounted volume when hosting so accounts and
# paper trades survive redeploys (e.g. DATA_DIR=/var/data on Render/Fly).
# DATA_DIR=./data

# Public registration. On by default for local use; set to "off" on a public
# deployment so only the seeded owner account can sign in.
# ALLOW_SIGNUP=off

# Keep a fixed set of accounts alive across restarts (hosts with an ephemeral disk
# wipe normal sign-ups on redeploy). Re-created on boot; idempotent.
# SEED_USERS=alice@example.com:secret1,bob@example.com:secret2

# ── Auth: email + password, no OTP ───────────────────────────────────────
# Nothing to configure. Email OTP and the mailer were removed entirely; the
# variables that once drove them (MAIL_PROVIDER, BREVO_API_KEY, SMTP_*,
# OTP_TTL_MINUTES, LOGIN_OTP) no longer exist. Password resets are done by the
# owner from Admin → Users.

# ── Scanner / data windows (all free Yahoo ranges) ───────────────────────
SCAN_CONCURRENCY=12
SCAN_DAILY_RANGE=8mo
SCAN_HOURLY_RANGE=45d
BACKTEST_DAILY_RANGE=2y
BACKTEST_HOURLY_RANGE=730d

# NSE option-chain requests are serialised with this minimum gap (ms).
# NSE limits ~1 request / 3s; lower only if you know your IP isn't throttled.
NSE_MIN_GAP_MS=3000

# Background price-alert poller: how often the server checks armed alerts
# against free quotes (ms). 0 disables the poller (browser-tab eval still works).
ALERT_POLL_MS=60000

# ── Optional live execution (Dhan) — live is OFF by default ──────────────
# Per-user Dhan keys are entered in-app (Settings), not here.
DHAN_BASE_URL=https://api.dhan.co
# Free simulated-order sandbox (toggled per-account in Settings → Dhan):
# DHAN_SANDBOX_URL=https://api-sandbox.dhan.co

# ── Owner account (prefer owner.json; env is also supported) ─────────────
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=change-me
